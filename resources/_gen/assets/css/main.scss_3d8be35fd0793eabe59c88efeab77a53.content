body[a="dark"]{background-color:#000;color:#fff}body[a="dark"] a{color:#79a8ff}body[a="dark"] a:visited{color:#f78fe7}body[a="dark"] details{border:thin solid #fff}body[a="dark"] details summary{color:#fff}body[a="dark"] details[open] summary{border-bottom:1px solid #fff}body[a="dark"] pre{background:#000}body[a="dark"] code:not(pre>code){background-color:#fff;color:#000}body[a="dark"] *:target{background:#2f3849;color:#fff}body[a="dark"] table,body[a="dark"] th,body[a="dark"] td{border:thin solid #fff}body[a="dark"] .toc{border:thin solid #fff;padding:1rem}body[a="dark"] figcaption{color:#000}body[a="dark"] blockquote{border:thin solid #fff}body[a="light"]{background-color:#fff;color:#000}body[a="light"] a{color:#3548cf}body[a="light"] a:visited{color:#8f0075}body[a="light"] details{border:thin solid #000}body[a="light"] details summary{color:#000}body[a="light"] details[open] summary{border-bottom:1px solid #000}body[a="light"] pre{background:#fff}body[a="light"] code:not(pre>code){background-color:#000;color:#fff}body[a="light"] *:target{background:#dae5ec;color:#000}body[a="light"] table,body[a="light"] th,body[a="light"] td{border:thin solid #000}body[a="light"] .toc{border:thin solid #000;padding:1rem}body[a="light"] figcaption{color:#595959}body[a="light"] blockquote{border:thin solid #000}@media (prefers-color-scheme: dark){body[a="auto"]{background-color:#000;color:#fff}body[a="auto"] a{color:#79a8ff}body[a="auto"] a:visited{color:#f78fe7}body[a="auto"] details{border:thin solid #fff}body[a="auto"] details summary{color:#fff}body[a="auto"] details[open] summary{border-bottom:1px solid #fff}body[a="auto"] pre{background:#000}body[a="auto"] code:not(pre>code){background-color:#fff;color:#000}body[a="auto"] *:target{background:#2f3849;color:#fff}body[a="auto"] table,body[a="auto"] th,body[a="auto"] td{border:thin solid #fff}body[a="auto"] .toc{border:thin solid #fff;padding:1rem}body[a="auto"] figcaption{color:#000}body[a="auto"] blockquote{border:thin solid #fff}}@media (prefers-color-scheme: light){body[a="auto"]{background-color:#fff;color:#000}body[a="auto"] a{color:#3548cf}body[a="auto"] a:visited{color:#8f0075}body[a="auto"] details{border:thin solid #000}body[a="auto"] details summary{color:#000}body[a="auto"] details[open] summary{border-bottom:1px solid #000}body[a="auto"] pre{background:#fff}body[a="auto"] code:not(pre>code){background-color:#000;color:#fff}body[a="auto"] *:target{background:#dae5ec;color:#000}body[a="auto"] table,body[a="auto"] th,body[a="auto"] td{border:thin solid #000}body[a="auto"] .toc{border:thin solid #000;padding:1rem}body[a="auto"] figcaption{color:#595959}body[a="auto"] blockquote{border:thin solid #000}}html{height:100%}body{font-family:monospace;font-size:16px;line-height:1.4;margin:0;min-height:100%;overflow-wrap:break-word}h2,h3,h4,h5,h6{margin-top:1.5rem}p{margin:1rem 0}li{margin:0.4rem 0}a{text-decoration:none}a:hover{text-decoration:underline}hr{text-align:center;border:0;margin:2rem 0}hr:before{content:'/////'}hr:after{content:attr(data-content) "/////"}pre{padding:1em;overflow-x:auto}table{width:100%}table,th,td{border-collapse:collapse;padding:0.4rem}code{text-size-adjust:100%;-ms-text-size-adjust:100%;-moz-text-size-adjust:100%;-webkit-text-size-adjust:100%}code:not(pre>code){padding:0.1em 0.2em;font-size:90%}code.has-jax{-webkit-font-smoothing:antialiased;background:inherit !important;border:none !important;font-size:100%}blockquote{padding:1rem}blockquote p{margin:0}img{max-width:100%;display:block;margin:0 auto}figcaption{text-align:center;opacity:0.5}details{padding:1rem}details summary{text-decoration:none}details[open] summary{margin-bottom:0.5em;padding-bottom:0.5em}.post-meta{display:flex;justify-content:space-between;align-items:center}.w{max-width:640px;margin:0 auto;padding:4rem 2rem}.toc{padding:1rem}.mermaid svg{display:block;height:auto;max-width:100%}.categories-box{border:1px solid currentColor;padding:10px 15px;max-height:180px;overflow-y:auto;margin-top:0.5rem;margin-bottom:1rem;border-radius:4px}.categories-list{list-style:none;padding-left:0;margin:0}.categories-list li{margin:0.3rem 0;display:flex;justify-content:space-between;align-items:center}.categories-list li a{text-decoration:none}.categories-list li a:hover{text-decoration:underline}.category-count{opacity:0.6;font-size:0.9em}details.qa-box{margin:1.5rem 0;border:1px solid currentColor;border-radius:6px;padding:0.8rem 1rem;background-color:rgba(127,127,127,0.05)}details.qa-box summary.qa-summary{cursor:pointer;font-weight:bold;display:flex;align-items:center;gap:0.75rem;user-select:none;list-style:none}details.qa-box summary.qa-summary::-webkit-details-marker{display:none}details.qa-box summary.qa-summary::before{content:"▶";font-size:0.8em;transition:transform 0.2s ease;display:inline-block}details.qa-box summary.qa-summary .qa-badge{font-size:0.75em;padding:0.2em 0.5em;border:1px solid currentColor;border-radius:4px;text-transform:uppercase;letter-spacing:0.05em;opacity:0.8;flex-shrink:0}details.qa-box summary.qa-summary .qa-title{flex-grow:1}details.qa-box[open] summary.qa-summary{border-bottom:1px dashed currentColor;margin-bottom:0.8rem;padding-bottom:0.8rem}details.qa-box[open] summary.qa-summary::before{transform:rotate(90deg)}details.qa-box .qa-content{margin-top:0.5rem}details.qa-box .qa-content p:first-child{margin-top:0}details.qa-box .qa-content p:last-child{margin-bottom:0}body.pared-section{background-color:#e9ddc4}body.pared-section .w{max-width:1150px;padding:0}body.pared-page .w{max-width:none;padding:0}.pared-pagina{min-height:100vh;box-sizing:border-box;padding:3rem clamp(1rem, 4vw, 3rem) 5rem;background-color:#e9ddc4;background-image:var(--tapizado, none);background-size:380px auto;background-attachment:fixed;color:#3d2f1a}.pared-volver{display:inline-block;margin-bottom:1rem;color:#000;font-size:0.95rem}.pared-volver:hover{text-decoration:underline}.pared-pagina h1{margin-top:1.2rem}.pared-wall{display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:clamp(40px, 6vw, 72px) clamp(30px, 4vw, 52px);max-width:1050px;margin:3rem auto 0}.pared-cuadro{position:relative;display:block;padding:0;background:transparent;border:none;cursor:pointer;transform:rotate(var(--rot, 0deg));transition:transform 0.2s ease, filter 0.2s ease}.pared-cuadro img{display:block;width:100%;user-select:none}.pared-cuadro:hover,.pared-cuadro:focus-visible{transform:rotate(var(--rot, 0deg)) translateY(-6px) scale(1.03);z-index:5}.pared-cuadro:focus-visible{outline:3px dashed #6b5432;outline-offset:5px}@media (max-width: 640px){.pared-cuadro{width:42% !important;margin-top:0 !important}}.marco-clasico,.marco-dorado,.marco-negro,.marco-blanco,.marco-roble{box-sizing:border-box;padding:clamp(10px, 1.4vw, 16px);background:linear-gradient(#f7f1e0, #efe6cf);box-shadow:0 12px 26px rgba(62,42,16,0.38)}.marco-clasico img,.marco-dorado img,.marco-negro img,.marco-blanco img,.marco-roble img{box-shadow:0 3px 12px rgba(50,32,10,0.45)}.marco-dorado{border:22px solid transparent;border-image:url("../img/marcos/dorado.png") 76 72 74 76/22px}.marco-clasico{border:30px solid transparent;border-image:url("../img/marcos/clasico.png") 279 274 278 274/30px}.marco-roble{border:30px solid transparent;border-image:url("../img/marcos/roble.png") 278 273 276 273/30px}.marco-negro{border:30px solid transparent;border-image:url("../img/marcos/negro.png") 278 272 276 273/30px}.marco-blanco{border:30px solid transparent;border-image:url("../img/marcos/blanco.png") 245 240 244 241/30px}[class^="marco-"]>img,[class*=" marco-"]>img{display:block;width:100%}.pared-modal{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:rgba(20,14,7,0.78);backdrop-filter:blur(5px);opacity:0;visibility:hidden;transition:opacity 0.22s ease, visibility 0.22s ease}.pared-modal.pared-modal-abierto{opacity:1;visibility:visible}.pared-modal-iframe{width:MIN(94vw, 900px);height:MIN(90vh, 900px);border:none;border-radius:10px;overflow:hidden;background:#e9ddc4;box-shadow:0 18px 60px rgba(0,0,0,0.55)}.pared-modal-cerrar{position:absolute;top:10px;right:22px;font-size:2.6rem;line-height:1;color:#f0e6d2;background:none;border:none;cursor:pointer;transition:transform 0.15s ease}.pared-modal-cerrar:hover{transform:scale(1.2)}body.pared-page{background-color:#e9ddc4;background-image:url("../img/tapizado.svg");background-size:380px auto;background-attachment:fixed}.pared-detalle-pagina{box-sizing:border-box;display:flow-root;padding:clamp(1.5rem, 4vh, 3rem) clamp(1rem, 3vw, 2.5rem);color:#000}.pared-detalle{margin:0 auto;max-width:MIN(94vw, 760px);text-align:center}.pared-detalle .pared-detalle-marco{display:inline-block;max-width:100%;min-width:MIN(70vw, 340px);min-height:220px}.pared-detalle .pared-detalle-marco img{max-height:56vh;width:auto;max-width:100%;height:auto;margin:0 auto}.pared-detalle-meta{opacity:1;margin-top:clamp(1.4rem, 4vh, 2.4rem)}.pared-detalle-meta .pared-detalle-titulo{margin:0 0 0.45rem;font-size:clamp(1.5rem, 3.2vw, 2rem);font-weight:bold}.pared-detalle-meta .pared-detalle-linea{margin:0.35rem 0 0;display:flex;justify-content:center;align-items:baseline;gap:0.65rem;font-size:1.08rem}.pared-detalle-meta .pared-detalle-linea .pared-detalle-autor{text-transform:uppercase;letter-spacing:0.09em;font-weight:bold}.pared-detalle-meta .pared-detalle-linea .pared-detalle-separador{opacity:0.5}.pared-detalle-meta .pared-detalle-linea time{opacity:1}.pared-detalle-meta .pared-detalle-descripcion{margin:1rem auto 0;max-width:58ch;font-size:1.08rem;line-height:1.65;font-style:italic}
